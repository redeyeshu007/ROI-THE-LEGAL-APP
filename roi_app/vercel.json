{
  "buildCommand": "bash build.sh",
  "outputDirectory": "build/web",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':!TODO.md' ':!BUGS.md' ':!testing-notes.txt' ':!future-updates.md' ':!dev-notes.md' ':!.github/workflows/**'"
}
